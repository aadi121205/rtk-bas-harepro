# Copy to ~/.config/herepro/base.env on the base station. No quotes, no inline comments.
NTRIP_PORT=2101
NTRIP_MOUNT=HEREPRO
# empty = auto-discover /dev/serial/by-id/usb-CubePilot_HerePro_*-if01 (survives replugs)
HEREPRO_SERIAL=
HEREPRO_BAUD=115200
# seconds between status lines in the journal (events are logged as they happen)
STATUS_S=10
# known reference point LAT,LON,HEIGHT_M (ellipsoidal height, not MSL); empty = keep
# whatever is saved in ~/.herepro_fiducial.json. Only used to measure error, never broadcast.
FIDUCIAL=
